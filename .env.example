# Where the MyDesk source lives (the test run starts its own server from it with an EMPTY temporary database)
MYDESK_APP_DIR=../MyDesk
# Port of that test server
MYDESK_TEST_PORT=5199

# Optional: send results to your real MyDesk → «Качество» (key from Качество → Подключение). Never commit the real key.
MYDESK_URL=https://<твой-сервер-mydesk>
MYDESK_QA_KEY=
